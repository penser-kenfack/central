# Bolo API – copy to .env and fill in
NODE_ENV=production
PORT=5000
CLIENT_URL=https://recrutement.example.cm
DATABASE_URL=postgresql://bolo:CHANGE_ME@db:5432/bolo
# 64 random characters: openssl rand -hex 32
JWT_SECRET=
JWT_TTL=8h
# 32 bytes in base64: openssl rand -base64 32  (keep a copy offline: without it the CVs cannot be read)
CV_ENCRYPTION_KEY=
STORAGE_DIR=/data/cv
CV_MAX_BYTES=5242880
CV_LINK_TTL_SECONDS=300
REJECTION_DELAY_HOURS=48
APPLY_LIMIT_PER_HOUR=20
CLAMAV_HOST=clamav
CLAMAV_PORT=3310
